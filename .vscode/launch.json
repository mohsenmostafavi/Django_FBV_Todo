{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Runserver",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        },
        {
            "name": "Django: Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/core/manage.py",
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "cwd": "${workspaceFolder}/core",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        }
    ]
}